# ── App ──────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# ── MongoDB ───────────────────────────
MONGODB_URI=mongodb://admin:secret@mongodb:27017/jamb_cbt?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secret

# ── Redis ─────────────────────────────
REDIS_URL=redis://:redispassword@redis:6379
REDIS_PASSWORD=redispassword

# ── Elasticsearch ─────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── RabbitMQ ──────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── JWT (RS256 — generate a real keypair) ─
JWT_PRIVATE_KEY=<base64-encoded RS256 private key>
JWT_PUBLIC_KEY=<base64-encoded RS256 public key>
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
FIELD_ENCRYPTION_KEY=<32-byte hex string>

# ── Auth / OAuth ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Notifications ─────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@jambcbt.ng
TERMII_API_KEY=
TERMII_SENDER_ID=JAMBCBT

# ── File Storage ──────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-west-1
# If S3 env vars are empty, files save to /uploads locally

# ── Deployment (Cloudflare Pages + DigitalOcean) ──
CF_PAGES_PROJECT_NAME=jamb-cbt-frontend
DO_APP_NAME=jamb-cbt-backend

# ── AI explanation cache (PostgreSQL-backed; disabled until rollout) ──
CBT_EXPLANATION_CACHE_ENABLED=false
PROMPT_VERSION=expl-v1
# Comma-separated Mistral-compatible API keys; environment-only. Existing MISTRAL_* aliases remain supported.
AI_API_KEYS=
CBT_USER_DAILY_AI_LIMIT=20
CBT_USER_PER_MINUTE_LIMIT=3
# Set an owner-approved positive cap before enabling generation; zero/unset fails closed for uncached calls.
CBT_GLOBAL_DAILY_AI_CAP=0
# Optional per-key/day cap; zero means no per-key cap.
PER_KEY_DAILY_CAP=0
REPORT_FLAG_THRESHOLD=3
CBT_USER_DAILY_EXPLANATION_REPORT_LIMIT=5
CBT_REPORT_HASH_SECRET=
PREWARM_REQUESTS_PER_MINUTE=10
AI_COST_PER_1K_TOKENS=0.0005
AI_COST_PER_REQUEST_ESTIMATE=0.00035
AI_PROVIDER_RETRIES=2
AI_RETRY_BASE_MS=250
AI_PROVIDER_TIMEOUT_MS=20000
CBT_CACHE_LOCK_TIMEOUT_MS=30000
